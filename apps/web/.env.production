VITE_BASE=/web/

# 请求路径
VITE_BASE_URL=https://mindtrip.emojump.com
# 接口地址
VITE_GLOB_API_URL=https://mindtrip.emojump.com/admin-api

# CDN配置 - 静态资源CDN地址
VITE_CDN_URL=https://mindtrip-1305613707.cos.ap-guangzhou.myqcloud.com/web

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=brotli

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 应用类型 - 用于区分不同应用的首页路径
VITE_APP_TYPE=web

# 应用名称
VITE_APP_NAME=学生端
