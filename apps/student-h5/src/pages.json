{
  "globalStyle": {
    "navigationStyle": "default",
    "navigationBarTitleText": "unibest",
    "navigationBarBackgroundColor": "#f8f8f8",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#FFFFFF"
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^fg-(.*)": "@/components/fg-$1/fg-$1.vue",
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
    }
  },
  "pages": [
    // GENERATED BY UNI-PAGES, PLATFORM: H5
    {
      "path": "pages/home/index",
      "type": "home",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "首页"
      }
    },
    {
      "path": "pages/auth/login",
      "type": "page",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/auth/no-access",
      "type": "page",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "无权限访问"
      }
    },
    {
      "path": "pages/user/confirm",
      "type": "page",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "确认信息"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages-sub",
      "pages": [
        // GENERATED BY UNI-PAGES, PLATFORM: H5
        {
          "path": "assessment/list",
          "type": "page",
          "style": {
            "navigationStyle": "custom",
            "navigationBarTitleText": "心理测评"
          }
        },
        {
          "path": "assessment/module",
          "type": "page",
          "style": {
            "navigationStyle": "custom",
            "navigationBarTitleText": "模块评估报告"
          }
        },
        {
          "path": "assessment/questionnaire",
          "type": "page",
          "layout": "empty",
          "style": {
            "navigationStyle": "custom",
            "navigationBarTitleText": "问卷答题",
            "disableScroll": true
          }
        },
        {
          "path": "assessment/result",
          "type": "page",
          "style": {
            "navigationStyle": "custom",
            "navigationBarTitleText": "测评结果"
          }
        },
        {
          "path": "assessment/scene",
          "type": "page",
          "layout": "empty",
          "style": {
            "navigationStyle": "custom",
            "navigationBarTitleText": "测评场景",
            "disableScroll": true
          }
        }
      ]
    }
  ]
}
